#!/usr/bin/env bash
# Runs the request decision on the JSON object read from standard input and prints the decision as one JSON object.
#
# The decision's jq program lives inline in the reusable workflow (.github/workflows/claude-review.yml, the decide
# job's REQUEST_DECISION variable), because a reusable workflow runs in the calling repository and cannot read files
# from this one. This wrapper reads the program out of the workflow, so the tests run exactly what ships.
#
# Needs bash, jq and yq. Either yq works: mikefarah's (as on GitHub's ubuntu-latest runners) or the Python jq wrapper.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workflow="$here/../.github/workflows/claude-review.yml"

program="$(yq -r '.jobs.decide.env.REQUEST_DECISION' "$workflow")"
if [[ -z "$program" || "$program" == "null" ]]; then
  echo "decide: no REQUEST_DECISION program found in $workflow" >&2
  exit 1
fi
exec jq --compact-output "$program"
